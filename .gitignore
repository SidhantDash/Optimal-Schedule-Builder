# dependencies
node_modules/

# build output
.next/
next-env.d.ts
out/
dist/
build/
.vinext/
.wrangler/
coverage/
*.tsbuildinfo

# Generated types (never committed; `devtools db types` or CI makes them)
src/supabase/database.types.ts
.devtools/

# Local configuration. `.env` is public-only; `.env.tooling` holds secrets.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Supabase CLI scratch
supabase/.temp/
supabase/.branches/

# `devtools db sync` records what a database has had applied here. The schema
# in supabase/schemas is the source of truth; migrations are generated and
# never committed, so a stray `git add .` must not pick them up.
supabase/migrations/

# misc
.DS_Store
*.pem
npm-debug.log*
.pnpm-debug.log*

# IDE
.idea/
