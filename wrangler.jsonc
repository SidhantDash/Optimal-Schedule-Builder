{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker names are `${tier}-dogdays`. The top level is the development
  // shape (`vinext dev`, `wrangler dev`); `staging` and `production` repeat
  // every non-inheritable key in full, because wrangler warns, and drops them,
  // when they are only set here.
  "name": "development-dogdays",
  // Pinned because the scoped deploy token defeats wrangler's account
  // inference. Not a secret.
  "account_id": "61d185ff419ef7bd5bd4b3d314081a49",
  // Custom entry: vinext's app-router `fetch` handler wrapped in Sentry's
  // `withSentry` (see cloudflare/worker.ts).
  "main": "cloudflare/worker.ts",
  // The date of the `workerd` the lockfile resolves, which is how
  // @cloudflare/vite-plugin derives its own default. Bump it with wrangler.
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // vinext resolves this itself at build time (to `dist/client`, relative to
  // the emitted `dist/server/wrangler.json`); the value only matters for a
  // bare `wrangler` run against this source file, which is not supported.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  // Cloudflare's own per-invocation log lines stay on beside Sentry: they
  // survive an unreachable or unconfigured Sentry.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // `cache.enabled` turns on vinext's CDN-cache adapter (vite.config.ts's
  // `cdnAdapter()`) over the Worker's Cache API.
  "cache": { "enabled": true },
  // The deployment's version id, readable in the Worker, for Sentry release
  // tagging and cache-key namespacing.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // --- development (top level) ---------------------------------------------
  "vars": {
    "DEPLOY_ENV": "development",
  },
  // vinext's data-cache adapter (`kvDataAdapter()` in vite.config.ts) stores
  // Next's fetch/`use cache` data here. `wrangler dev` runs local-only, so the
  // placeholder id is never resolved against the API.
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "<no-remote-namespace-development-runs-local-only>",
    },
  ],
  // `next/image` needs `sharp`, a native binary workerd cannot run.
  "images": {
    "binding": "IMAGES",
  },

  "env": {
    "staging": {
      "name": "staging-dogdays",
      "vars": {
        "DEPLOY_ENV": "staging",
      },
      // Created with `wrangler kv namespace create staging-dogdays-vinext-cache`.
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
          "id": "36809a4b06484c8ebf4c6027f4f21577",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "cache": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // DogDays lives on its own zone, dogdays.dev. Change it here and in the
      // staging `BASE_URL` variable together; nothing cross-checks them.
      "routes": [
        {
          "pattern": "staging.dogdays.dev",
          "custom_domain": true,
        },
      ],
    },

    "production": {
      "name": "production-dogdays",
      "vars": {
        "DEPLOY_ENV": "production",
      },
      // No `id`: wrangler creates the namespace on the first full deploy and
      // names it after the binding. Without the binding every `fetch`/`use
      // cache` read misses and re-executes per request.
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "cache": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // Keep in step with the production `BASE_URL` variable. The old Worker
      // (DevDogsUGA's `production-schedule-builder`) holds this hostname until
      // the first full deploy of this one claims it, at the Gate.
      "routes": [
        {
          "pattern": "dogdays.dev",
          "custom_domain": true,
        },
      ],
    },
  },
}
