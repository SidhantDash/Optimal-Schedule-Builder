# DogDays' public configuration. `pnpm devtools setup` copies this to `.env`
# and fills the two Supabase lines for your own database. Every value here is
# public: it ships in the browser bundle. Secrets never go in this file; the
# tooling keeps its own in `.env.tooling`, which git ignores.

# Your Supabase project (hosted or the local Docker stack). `pnpm devtools
# setup` writes these two.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The course catalog every DevDogs app reads: public, keyless, read-only. The
# staging catalog has the same terms and sections as production.
NEXT_PUBLIC_CATALOG_URL=https://api-staging.devdogsuga.org/catalog/v1

# Google Maps JavaScript API browser key for the Map of Classes. A browser key
# is public by design: it only works from dogdays.dev and localhost, and Google
# Cloud caps its daily loads. Nothing else of Google's can be called with it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyC_qavEMJ-WOyS04_FWWvKWI3oP9yTEgVI

# Sentry. Leave blank locally: no DSN means Sentry never starts.
NEXT_PUBLIC_SENTRY_DSN=

# development | staging | production. Only the deploy sets anything else.
NEXT_PUBLIC_DEPLOY_ENV=development
